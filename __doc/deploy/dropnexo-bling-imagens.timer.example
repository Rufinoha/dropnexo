# Renovação noturna de links de imagem Bling (modo "Somente link")
# Copiar para /etc/systemd/system/ e ajustar paths/usuário.
#
#   sudo cp dropnexo-bling-imagens.service.example /etc/systemd/system/dropnexo-bling-imagens.service
#   sudo cp dropnexo-bling-imagens.timer.example /etc/systemd/system/dropnexo-bling-imagens.timer
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dropnexo-bling-imagens.timer

# --- dropnexo-bling-imagens.service ---
# [Unit]
# Description=DropNexo revalidar imagens Bling
# After=network.target postgresql.service
#
# [Service]
# Type=oneshot
# User=www-data
# Group=www-data
# WorkingDirectory=/srv/dropnexo
# EnvironmentFile=/srv/dropnexo/.env
# ExecStart=/srv/dropnexo/venv/bin/python /srv/dropnexo/scripts/bling_revalidar_imagens.py --dias 3
#
# [Install]
# WantedBy=multi-user.target

[Unit]
Description=Timer DropNexo revalidar imagens Bling (madrugada)

[Timer]
OnCalendar=*-*-* 03:15:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
